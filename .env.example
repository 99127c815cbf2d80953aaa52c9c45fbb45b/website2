# Firebase web config for the pre-register form.
#
# Copy this file to .env.local and fill in the values from
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup.
# .env.local is gitignored (see the *.local rule in .gitignore).
#
# NOT SECRETS. Vite inlines every VITE_* value into the JS bundle, so these
# ship to the browser and anyone can read them. That is how Firebase web apps
# work — the config identifies the project, it does not grant access.
# The real protection is firestore.rules. Keep the keys out of the repo for
# tidiness and scraping, but do not rely on that for security.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aphro-xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aphro-xxxxx
VITE_FIREBASE_STORAGE_BUCKET=aphro-xxxxx.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
